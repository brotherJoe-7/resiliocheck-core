# ResilioCheck Core — Environment Variable Template
# Copy this file to `.env` and fill in real values.  NEVER commit `.env`.

# ── AI / LLM ──────────────────────────────────────────────────────────────
# Groq API key — powers the AI analysis (https://console.groq.com/)
GROQ_API_KEY=
# Groq model to use for analysis
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0

# ── GitHub ─────────────────────────────────────────────────────────────────
# Personal Access Token with `repo` scope — used for automated PR creation
GITHUB_TOKEN=
# HMAC secret to verify GitHub webhook signatures (X-Hub-Signature-256).
GITHUB_WEBHOOK_SECRET=

# ── Auth ───────────────────────────────────────────────────────────────────
# REQUIRED: A long, random secret key used to sign JWT tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# ── CORS / Frontend ────────────────────────────────────────────────────────
# The origin URL of your frontend (no trailing slash).
FRONTEND_URL=http://localhost:3000

# ── Sandbox ────────────────────────────────────────────────────────────────
DOCKER_SOCKET=unix:///var/run/docker.sock
SANDBOX_TIMEOUT_SECONDS=180

# ── Logging / Environment ──────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
