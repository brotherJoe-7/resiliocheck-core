# ResilioCheck Core — Environment Variable Template
# Copy this file to `.env` and fill in real values.  NEVER commit `.env`.

# ── Environment ────────────────────────────────────────────────────────────
# development | production   (production REQUIRES JWT_SECRET_KEY)
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── AI / LLM (Groq) ────────────────────────────────────────────────────────
# Groq API key — powers the AI analysis (https://console.groq.com/)
GROQ_API_KEY=
# Primary model.  openai/gpt-oss-120b is the strongest model on the Groq
# free/developer tier.  NOTE: llama-3.3-70b-versatile is enterprise-only.
GROQ_MODEL=openai/gpt-oss-120b
# Ordered fallbacks used when the primary model is rate-limited (429),
# decommissioned (404/400) or otherwise unavailable.  Groq limits are per
# model, so hopping models keeps a scan going instead of failing.
# Example with OpenRouter: openrouter/deepseek/deepseek-coder
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.6-27b,llama-3.3-70b-versatile,llama-3.1-8b-instant,deepseek-coder
LLM_TEMPERATURE=0.0
# Groq free tier = 8 000 tokens / minute per model. Keep every request below it.
LLM_TPM_BUDGET=8000
LLM_MAX_OUTPUT_TOKENS=1800
LLM_MAX_CONTEXT_CHARS=14000
LLM_MAX_CHARS_PER_FILE=1400
# Max seconds the pipeline may spend waiting on rate limits before it returns
# a clean HTTP 429 to the caller (keep below your Cloud Run request timeout).
LLM_MAX_TOTAL_WAIT_SECONDS=150
LLM_REQUEST_TIMEOUT_SECONDS=90
# deterministic (default, 0 extra LLM calls) | llm (asks the model to confirm)
GATE_AGENT_MODE=deterministic
# Files larger than this are reported but not auto-patched.
PATCH_MAX_FILE_CHARS=6000
# How many source files are sent to the OWASP agent per scan.
MAX_FILES_FOR_AI=12

# ── GitHub ─────────────────────────────────────────────────────────────────
# Personal Access Token with `repo` scope — used for automated PR creation
GITHUB_TOKEN=
# HMAC secret to verify GitHub webhook signatures (X-Hub-Signature-256).
# Also used when ResilioCheck auto-registers webhooks on monitored repos.
GITHUB_WEBHOOK_SECRET=
# GitHub OAuth App (Settings → Developer settings → OAuth Apps).
# Enables "Connect GitHub" for private-repository scanning.
# Authorization callback URL must be: <BACKEND_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Auth ───────────────────────────────────────────────────────────────────
# A long, random secret key used to sign JWT tokens.  Required in production;
# in development an ephemeral key is generated on each start.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_HOURS=24

# ── CORS / Frontend ────────────────────────────────────────────────────────
# Comma-separated origin URL(s) of your frontend (no trailing slash).
FRONTEND_URL=http://localhost:3000

# ── Backend URL ────────────────────────────────────────────────────────────
# The public URL of this backend service (e.g. your Cloud Run URL).
# Required for auto-configuring GitHub webhooks.
BACKEND_URL=http://localhost:8000


# ── Database ───────────────────────────────────────────────────────────────
# SQLite by default for dev; use postgresql://user:pass@host/db in production
# (e.g. Neon PostgreSQL for serverless scale).
DATABASE_URL=sqlite:///./resiliocheck.db

# ── Sandbox ────────────────────────────────────────────────────────────────
# Patch validation runs in-process via subprocess (bandit / semgrep / node
# --check / py_compile …) — no Docker daemon needed.  Set false to skip.
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=180
