# ResilioCheck Core — Environment Variable Template
# Copy this file to `.env` and fill in real values.  NEVER commit `.env`.

# ── AI / LLM ──────────────────────────────────────────────────────────────────
# Groq API key — powers the AI analysis (https://console.groq.com/)
GROQ_API_KEY=
# Groq model to use for analysis
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token with `repo` scope — used for automated PR creation
GITHUB_TOKEN=
# HMAC secret to verify GitHub webhook signatures (X-Hub-Signature-256).
# Strongly recommended for any non-local deployment.
GITHUB_WEBHOOK_SECRET=

# ── Service URLs ──────────────────────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
ENGINE_URL=http://localhost:8001
SANDBOX_URL=http://localhost:8002
DASHBOARD_PORT=8501

# ── Sandbox ───────────────────────────────────────────────────────────────────
DOCKER_SOCKET=unix:///var/run/docker.sock
SANDBOX_TIMEOUT_SECONDS=120

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chromadb

# ── Logging / Environment ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
ENVIRONMENT=development
