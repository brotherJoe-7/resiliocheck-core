{
  "name": "ResilioCheck AI",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "backend/main.py"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements-dev.txt && cd frontend && npm install",
  "postAttachCommand": {
    "backend": "uvicorn backend.main:app --host 0.0.0.0 --port 8000 --reload",
    "frontend": "cd frontend && NEXT_PUBLIC_API_URL=http://localhost:8000 npm run dev"
  },
  "portsAttributes": {
    "8000": {
      "label": "FastAPI backend"
    },
    "3000": {
      "label": "Next.js dashboard",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    3000,
    8000
  ]
}
